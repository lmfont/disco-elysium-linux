<?xml version="1.0" encoding="utf-8"?>
<!-- The compile-only UnityEngine reference assembly is published by BepInEx
     (it is not on nuget.org); everything else comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
